---
import Base from '../layouts/Base.astro';
import MailForm from '../components/MailForm.astro';
---
<Base title="MPM & Dalcroze" path="/mpm-dalcroze">
  <section class="page">
    <div class="wrap">
      <h1 class="title">The Music Paint Machine &amp; the Dalcroze Approach</h1>
      <h2>Presentation <a href="http://www.dalcroze.eu/" target="_blank" rel="noopener">Institut Dalcroze Belgique</a></h2>
      <p><a class="btn" href="/files/nijs_mp_dalcroze.pdf">Download the presentation (PDF)</a></p>
      <h2>Interested in collaborating? <span class="muted">Intéressé à collaborer?</span></h2>
      <p>Just send me a message… Envoyez-moi un message…</p>
      <MailForm id="dalcroze-form" subject="MPM & Dalcroze via website" />
    </div>
  </section>
</Base>
