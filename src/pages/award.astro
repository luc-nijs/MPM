---
import Base from '../layouts/Base.astro';
---
<Base title="Award" path="/award" description="In 2012 the research with the Music Paint Machine received the EAPRIL Best Research and Practice Project Award.">
  <section class="page">
    <div class="wrap">
      <div class="cols side">
        <figure><img src="/images/award-logo.jpg" alt="The EAPRIL award statuette: a figure climbing a staircase" width="249" height="800" style="width:150px;margin:0 auto" /></figure>
        <div>
          <h1 class="title">EAPRIL Best Research and Practice Project Award 2012</h1>
          <p><i>The EAPRIL Best Research and Practice Project Award aims to recognize the best project in the field of practitioner research.</i></p>
          <p><a href="http://www.eapril.org/EAPRILAward" target="_blank" rel="noopener">More info</a></p>
          <div class="cols" style="margin-top:34px">
            <figure>
              <h2>The four nominees</h2>
              <img src="/images/award-nominees.jpg" alt="The four nominees for the award" width="417" height="278" />
            </figure>
            <figure>
              <h2>Receiving the award</h2>
              <img src="/images/award-receiving.jpg" alt="Luc Nijs receiving the award" width="417" height="278" />
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
