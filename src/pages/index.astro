---
import Base from '../layouts/Base.astro';
import { SHEET_CSV_URL, recordsFromCSV, current, newsHtml } from '../lib/news.js';
import newsCsv from '../data/MPM_news.csv?raw';

// News is written into the page at the build (for search engines); the browser
// then reads the sheet again, so new items show without waiting for a rebuild.
// Until the sheet exists, the example in src/data/MPM_news.csv is used.
let news = [];
try { news = recordsFromCSV(newsCsv); } catch {}
if (SHEET_CSV_URL) {
  try {
    const res = await fetch(SHEET_CSV_URL, { signal: AbortSignal.timeout(20000) });
    if (res.ok) news = recordsFromCSV(await res.text());
  } catch {}
}
const shown = current(news);
---
<Base title="Home" path="/">
  <section class="news" id="news" hidden={!shown.length}>
    <div class="wrap">
      <div class="box news-box">
        <h2>News</h2>
        <div id="news-list" set:html={newsHtml(shown)}></div>
      </div>
    </div>
  </section>

  <section class="page home">
    <div class="wrap">
      <div class="home-intro">
        <figure><img src="/images/home-photo.jpg" alt="A young clarinettist, seen from behind, plays in front of a colourful digital painting made with the Music Paint Machine" width="845" height="564" /></figure>
        <div>
          <p class="lead"><b>The Music Paint Machine</b> is an interactive music system that allows musicians to make a digital painting by playing music and by moving on a coloured (dance)mat. Unlike in many interactive music systems, the acoustic musical instrument is not replaced by an electronic controller (e.g. Wii) or by sensors on the body. It is the unity of body and musical instrument that allows the musician to control the system. The various musical parameters (e.g. volume, pitch) that are changed with the musical instrument, and the movements of the musician (e.g. turning, bending, stepping on a coloured pressure mat) are converted into visual parameters (e.g. thickness of a line, colour, transparency, drawing direction) and displayed in real time on a screen.</p>
          <div class="btns">
            <a class="btn" href="/publications/">Publications</a>
            <a class="btn" href="/presentations/">Presentations</a>
          </div>
        </div>
      </div>

      <div class="home-boxes">
        <div class="box demo">
          <h2>Interested in a demo?</h2>
          <p>Or, you want to use the system yourself? Please <a href="/contact/">contact</a> me for more info, remarks, questions, …</p>
        </div>
        <div class="box award">
          <h2>Award</h2>
          <p>In 2012, my research with the Music Paint Machine has been honoured with the <b>EAPRIL Best Research and Practice Award</b>. <a href="/award/">More info</a></p>
        </div>
      </div>

      <div class="world">
        <img src="/images/worldwide.png" alt="World map showing where visitors of the site come from" width="166" height="92" />
        <p>Worldwide interest in the MPM…<br />Follow the MPM on <a href="https://www.facebook.com/musicpaintmachine" target="_blank" rel="noopener">Facebook</a>.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { SHEET_CSV_URL, recordsFromCSV, current, newsHtml } from '../lib/news.js';
  if (SHEET_CSV_URL) {
    // Cache-bust per minute so a sheet edit is not masked by a stale copy.
    fetch(SHEET_CSV_URL + '&v=' + Math.floor(Date.now() / 60000), { cache: 'no-cache' })
      .then((res) => { if (!res.ok) throw new Error('HTTP ' + res.status); return res.text(); })
      .then((text) => {
        const shown = current(recordsFromCSV(text));
        const list = document.getElementById('news-list');
        const fresh = document.createElement('div');
        fresh.innerHTML = newsHtml(shown);
        // Redraw only when the news changed, so pictures already showing don't reload.
        if (fresh.innerHTML !== list.innerHTML) list.innerHTML = fresh.innerHTML;
        document.getElementById('news').hidden = !shown.length;
      })
      .catch(() => {});
  }
</script>
